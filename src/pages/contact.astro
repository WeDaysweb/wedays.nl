---
import homepage from "../data/homepage.json";
import packages from "../data/packages.json";
import pageSeo from "../data/pageSeo.json";
import "../styles/global.css";
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageSeo["contact"].title}</title>
    <meta name="description" content={pageSeo["contact"].description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://wedays.nl/contact" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WeDays" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content="https://wedays.nl/contact" />
    <meta property="og:title" content={pageSeo["contact"].title} />
    <meta property="og:description" content={pageSeo["contact"].description} />
    <meta property="og:image" content="https://wedays.nl/wedays-logo-full.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageSeo["contact"].title} />
    <meta name="twitter:description" content={pageSeo["contact"].description} />
    <meta name="twitter:image" content="https://wedays.nl/wedays-logo-full.png" />
    <link rel="icon" type="image/png" href="/wedays-logo-full.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://wedays.nl/#organization",
          "name": "WeDays",
          "url": "https://wedays.nl/",
          "logo": "https://wedays.nl/wedays-logo-full.png",
          "image": "https://wedays.nl/wedays-logo-full.png",
          "description": "WeDays ontwerpt en bouwt op maat gemaakte websites voor bedrijven die online willen opvallen \u2014 premium design, sterke conversie en een degelijke technische basis.",
          "email": "info@wedays.nl",
          "address": { "@type": "PostalAddress", "addressCountry": "NL" }
        },
        {
          "@type": "WebSite",
          "@id": "https://wedays.nl/#website",
          "url": "https://wedays.nl/",
          "name": "WeDays",
          "publisher": { "@id": "https://wedays.nl/#organization" },
          "inLanguage": "nl-NL"
        },
        {
          "@type": "Website + DomeinService",
          "@id": "https://wedays.nl/#service",
          "name": "WeDays Webdesign",
          "url": "https://wedays.nl/",
          "image": "https://wedays.nl/wedays-logo-full.png",
          "provider": { "@id": "https://wedays.nl/#organization" },
          "areaServed": "NL",
          "priceRange": "\u20ac1.245+",
          "serviceType": ["Website laten maken", "Website redesign", "Landingspagina", "Webteksten", "Basis SEO"]
        }
      ]
    }
    </script>
  </head>
  <body>
<div class="progress"></div><div class="page-bg"></div><div class="noise"></div>
<header class="nav"><div class="container nav-inner"><a class="logo brand-logo" href="/" data-route="home" aria-label="WeDays home"><img class="brand-full-logo" src="/wedays-logo-full.png" alt="WeDays" width="192" height="58" /></a><nav class="nav-links"><a href="/diensten" data-route="diensten">Diensten</a><a href="/pakketten" data-route="pakketten">Pakketten</a><a href="/werkwijze" data-route="werkwijze">Werkwijze</a><a href="/website-scan" data-route="website-scan">Website Scan</a><a href="/blog" data-route="blog">Blog</a></nav><div class="nav-actions"><a class="btn btn-secondary" href="/keuzehulp" data-route="keuzehulp">Keuzehulp</a><a class="btn btn-primary" href="/contact" data-route="contact">Plan kennismaking →</a></div><button class="menu-btn">☰</button></div></header>
<main><div id="page-home" class="preview-page">
<section class="hero hero-v2">
  <div class="container">
    <div class="hero-v2-inner">

      <div class="hero-v2-copy reveal">
        <div class="hero-v2-label">
          <span class="hero-v2-dot"></span>
          <span>Webdesign studio · Nederland</span>
        </div>
        <h1 class="hero-v2-heading">
          Websites die<br>
          niemand<br>
          <em class="hero-v2-em">vergeet.</em>
        </h1>
        <p class="hero-v2-sub">Website + Beheer design voor bedrijven die online willen opvallen. Clean, scherp en gebouwd om aanvragen binnen te halen.</p>
        <div class="hero-v2-actions">
          <a class="btn btn-primary" href="/contact" data-route="contact">Start een project →</a>
        </div>
      </div>

      <div class="hero-v2-visual reveal">
        <div class="hero-v2-browser">
          <div class="hvb-bar">
            <span class="hvb-dots"><i></i><i></i><i></i></span>
            <span class="hvb-url">wedays.nl/project</span>
          </div>
          <div class="hvb-body">
            <div class="hvb-nav">
              <div class="hvb-brand"><b>W</b>Days</div>
              <div class="hvb-nav-links"><span></span><span></span><span></span></div>
              <div class="hvb-cta"></div>
            </div>
            <div class="hvb-hero">
              <div class="hvb-pill"></div>
              <div class="hvb-title">Website + Beheer<br>website.</div>
              <div class="hvb-lines"><span></span><span></span></div>
              <div class="hvb-btns"><span class="hvb-btn-a"></span><span class="hvb-btn-b"></span></div>
            </div>
            <div class="hvb-grid">
              <div class="hvb-card hvb-card-a"></div>
              <div class="hvb-card hvb-card-b"></div>
              <div class="hvb-card hvb-card-c"></div>
            </div>
          </div>
        </div>
        <div class="hero-chip hero-chip-score">
          <span class="chip-num">98</span>
          <span class="chip-label">Kwaliteit<br>score</span>
        </div>
        <div class="hero-chip hero-chip-project">
          <span class="chip-icon">↗</span>
          <div>
            <strong>Nieuw project</strong>
            <span>Gestart vandaag</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="lifeline-section">
  <div class="container reveal">
    <div class="lifeline-wrap">
      <div class="lifeline-intro">
        <div>
          <span class="eyebrow">De levenslijn van WeDays</span>
          <h2>Zes principes die in elke website blijven doorstromen.</h2>
        </div>
        <p>Dit zijn geen losse voordelen, maar de vaste punten waar elke WeDays-website op gebouwd wordt, van eerste indruk tot contactaanvraag.</p>
      </div>

      <div class="lifeline-svg" aria-hidden="true">
        <svg viewBox="0 0 1140 92" preserveAspectRatio="none">
          <path class="lifeline-path-bg lifeline-wave" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
          <path class="lifeline-path" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
          <path class="lifeline-glow-soft" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
          <path class="lifeline-glow-core" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
        </svg>
      </div>

      <div class="lifeline-grid">
        <div class="lifeline-card">
          <span class="lifeline-num">01</span>
          <h3>Snel gebouwd</h3>
          <p>Tempo zonder rommelig te worden. Snel opleveren met een professionele basis die direct klopt.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">02</span>
          <h3>Mobielvriendelijk</h3>
          <p>Een sterke ervaring op telefoon, omdat daar vaak de eerste echte kennismaking plaatsvindt.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">03</span>
          <h3>Conversiegericht</h3>
          <p>Bezoekers moeten niet zoeken. De route naar contact, scan of aanvraag hoort vanzelf duidelijk te zijn.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">04</span>
          <h3>Professioneel design</h3>
          <p>Clean, premium en rustig: een uitstraling die past bij de kwaliteit van het bedrijf erachter.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">05</span>
          <h3>Basis SEO</h3>
          <p>De fundering staat goed: logische headings, metadata, structuur en snelheid als nette technische basis.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">06</span>
          <h3>Duidelijke communicatie</h3>
          <p>Heldere teksten en logische opbouw, zodat bezoekers direct begrijpen wat je doet en waarom.</p>
        </div>
      </div>
      <div class="lifeline-note">De lijn blijft bewegen, net als de aandacht, structuur en flow van een goede website.</div>
    </div>
  </div>
</section>

<section class="section problems-section">
  <div class="container problems-wrap">

    <div class="problems-left reveal">
      <span class="eyebrow">Herkenbaar probleem</span>
      <h2>Je website is vaak de eerste indruk. Zorg dat die klopt.</h2>
      <p>Een verouderde of onduidelijke website kost vertrouwen, nog voordat iemand contact opneemt. Wij weten precies waar het misgaat.</p>
      <a class="btn btn-secondary" href="/website-scan" data-route="website-scan">Laat mijn website beoordelen →</a>
    </div>

    <div class="problems-right reveal">
      <div class="audit-panel">

        <div class="audit-panel-head">
          <div class="audit-scan-status">
            <span class="audit-scan-dot"></span>
            <span>Website scan actief</span>
          </div>
          <span class="audit-issues-badge">4 verbeterpunten</span>
        </div>

        <div class="audit-items">

          <div class="audit-item">
            <div class="audit-item-main">
              <span class="audit-sev audit-sev-high"></span>
              <div class="audit-item-text">
                <span class="audit-cat">Uitstraling</span>
                <strong class="audit-name">Verouderde uitstraling</strong>
              </div>
              <span class="audit-flag audit-flag-high">Hoog</span>
            </div>
            <div class="audit-item-detail">
              <p>De website past niet meer bij de kwaliteit van het bedrijf erachter.</p>
              <div class="audit-impact-row">
                <span>Impact op vertrouwen</span>
                <div class="audit-bar"><span style="--w:88%"></span></div>
                <span class="audit-pct">88%</span>
              </div>
            </div>
          </div>

          <div class="audit-item">
            <div class="audit-item-main">
              <span class="audit-sev audit-sev-high"></span>
              <div class="audit-item-text">
                <span class="audit-cat">Conversie</span>
                <strong class="audit-name">Weinig aanvragen</strong>
              </div>
              <span class="audit-flag audit-flag-high">Hoog</span>
            </div>
            <div class="audit-item-detail">
              <p>Er zijn bezoekers, maar geen duidelijke route naar contact of aanvraag.</p>
              <div class="audit-impact-row">
                <span>Impact op conversie</span>
                <div class="audit-bar"><span style="--w:82%"></span></div>
                <span class="audit-pct">82%</span>
              </div>
            </div>
          </div>

          <div class="audit-item">
            <div class="audit-item-main">
              <span class="audit-sev audit-sev-med"></span>
              <div class="audit-item-text">
                <span class="audit-cat">Mobiel</span>
                <strong class="audit-name">Slecht mobiel</strong>
              </div>
              <span class="audit-flag audit-flag-med">Middel</span>
            </div>
            <div class="audit-item-detail">
              <p>Op telefoon voelt de site traag, rommelig of onduidelijk aan.</p>
              <div class="audit-impact-row">
                <span>Impact op bereik</span>
                <div class="audit-bar audit-bar-med"><span style="--w:74%"></span></div>
                <span class="audit-pct">74%</span>
              </div>
            </div>
          </div>

          <div class="audit-item">
            <div class="audit-item-main">
              <span class="audit-sev audit-sev-high"></span>
              <div class="audit-item-text">
                <span class="audit-cat">Boodschap</span>
                <strong class="audit-name">Geen scherpe boodschap</strong>
              </div>
              <span class="audit-flag audit-flag-high">Hoog</span>
            </div>
            <div class="audit-item-detail">
              <p>Het is niet meteen duidelijk wat je doet en waarom men voor jou kiest.</p>
              <div class="audit-impact-row">
                <span>Impact op overtuiging</span>
                <div class="audit-bar"><span style="--w:79%"></span></div>
                <span class="audit-pct">79%</span>
              </div>
            </div>
          </div>

        </div>

        <div class="audit-panel-foot">
          <p>Herken je dit? Wij beoordelen jouw website gratis op al deze punten.</p>
          <a class="btn btn-primary" href="/website-scan" data-route="website-scan">Ontdek jouw score →</a>
        </div>

      </div>
    </div>

  </div>
</section>
<section class="services-premium section" id="home-services">
  <div class="container">
    <div class="services-premium-head reveal">
      <div>
        <span class="eyebrow">De oplossing</span>
        <h2>Strak design, duidelijke structuur en slimme techniek.</h2>
        <p class="lead">Een WeDays-website voelt niet als een standaard template. Elk onderdeel helpt bezoekers sneller begrijpen, vertrouwen en doorklikken.</p>
      </div>
      <div class="services-proof-card" aria-hidden="true">
        <span>5 focuspunten</span>
        <strong>Van eerste indruk naar aanvraag</strong>
        <p>Design, tekst, flow, mobiel en vindbaarheid worden als één geheel ontworpen.</p>
      </div>
    </div>

    <div class="services-showcase reveal">
      <div class="services-orbit" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <a class="service-tile service-tile-featured" href="/diensten" data-route="diensten" data-service-card>
        <span class="service-index">01</span>
        <div class="service-icon">◎</div>
        <div class="service-content">
          <span class="service-kicker">Complete basis</span>
          <h3>Website laten maken</h3>
          <p>Een moderne website die professioneel voelt, logisch uitlegt wat je doet en bezoekers rustig naar contact stuurt.</p>
          <div class="service-tags"><span>Structuur</span><span>Design</span><span>Conversie</span></div>
        </div>
        <span class="service-cta">Bekijk dienst →</span>
      </a>

      <a class="service-tile" href="/diensten" data-route="diensten" data-service-card>
        <span class="service-index">02</span>
        <div class="service-icon">↻</div>
        <div class="service-content">
          <span class="service-kicker">Nieuwe uitstraling</span>
          <h3>Website redesign</h3>
          <p>Van verouderd of rommelig naar helder, premium en betrouwbaar.</p>
        </div>
        <span class="service-cta">Bekijk dienst →</span>
      </a>

      <a class="service-tile" href="/diensten" data-route="diensten" data-service-card>
        <span class="service-index">03</span>
        <div class="service-icon">↗</div>
        <div class="service-content">
          <span class="service-kicker">Gericht resultaat</span>
          <h3>Landingspagina</h3>
          <p>Eén scherpe pagina voor campagnes, leads, acties of een duidelijke aanvraagflow.</p>
        </div>
        <span class="service-cta">Bekijk dienst →</span>
      </a>

      <a class="service-tile" href="/diensten" data-route="diensten" data-service-card>
        <span class="service-index">04</span>
        <div class="service-icon">✎</div>
        <div class="service-content">
          <span class="service-kicker">Heldere boodschap</span>
          <h3>Webteksten</h3>
          <p>Teksten die uitleggen, vertrouwen geven en bezoekers helpen een keuze te maken.</p>
        </div>
        <span class="service-cta">Bekijk dienst →</span>
      </a>

      <a class="service-tile" href="/diensten" data-route="diensten" data-service-card>
        <span class="service-index">05</span>
        <div class="service-icon">⌕</div>
        <div class="service-content">
          <span class="service-kicker">Vindbare fundering</span>
          <h3>Basis SEO</h3>
          <p>Een nette technische en inhoudelijke basis met logische headings, metadata en snelheid.</p>
        </div>
        <span class="service-cta">Bekijk dienst →</span>
      </a>
    </div>
  </div>
</section>
<section class="section">
  <div class="container grid-2">
    <div class="reveal">
      <span class="eyebrow">Meer dan mooi</span>
      <h2>Een goede website doet meer dan er mooi uitzien.</h2>
      <ul class="list">
        <li>Wekt vertrouwen bij nieuwe bezoekers</li>
        <li>Maakt direct duidelijk wat je doet</li>
        <li>Stuurt bezoekers naar de juiste actie</li>
        <li>Werkt snel en prettig op mobiel</li>
        <li>Past bij de kwaliteit van je bedrijf</li>
      </ul>
    </div>
    <div class="before-after reveal" data-before-after>
      <div class="ba-layer ba-before">
        <div class="ba-inner">
          <span class="ba-label ba-label-old">Oude website</span>
          <div class="ba-frame bad-site">
            <div class="bad-top"><i></i><i></i><i></i></div>
            <div class="bad-header">
              <div class="bad-logo">SUPER SNEL • GOEDKOOP • ALLES!!!</div>
              <div class="bad-nav"><span>HOME</span><span>OVER</span><span>ALLES</span><span>CONTACT</span></div>
            </div>
            <div class="bad-body">
              <div class="bad-main">
                <span class="bad-badge">NU TIJDELIJK! BEL ONS!</span>
                <h4>WIJ DOEN ECHT ALLES VOOR IEDEREEN!!!</h4>
                <div class="bad-lines"><span></span><span></span><span></span><span></span></div>
                <div class="bad-buttons">
                  <span class="bad-btn bad-btn-red">Klik hier</span>
                  <span class="bad-btn bad-btn-green">Vraag offerte</span>
                </div>
                <div class="bad-grid">
                  <div class="bad-card"><strong>Onze service</strong><span></span><span></span></div>
                  <div class="bad-card"><strong>Waarom wij?</strong><span></span><span></span></div>
                  <div class="bad-card"><strong>Nieuws</strong><span></span><span></span></div>
                  <div class="bad-card"><strong>Acties!!!</strong><span></span><span></span></div>
                </div>
              </div>
              <div class="bad-sidebar">
                <div class="bad-alert">Te veel tekst, drukke kleuren, geen focus en geen duidelijke route.</div>
                <h5>Laatste updates</h5>
                <div class="bad-side-lines"><span></span><span></span><span></span></div>
                <div class="bad-ad"></div>
                <div class="bad-mini"><span></span><span></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ba-layer ba-after">
        <div class="ba-inner">
          <span class="ba-label ba-label-new">Nieuwe website</span>
          <div class="ba-frame good-site">
            <div class="good-top"><i></i><i></i><i></i></div>
            <div class="good-header">
              <div class="good-brand"><span class="good-brand-mark"><span class="gb-w">W</span><span class="gb-d">D</span></span>WeDays</div>
              <div class="good-nav"><span>Diensten</span><span>Pakketten</span><span>Cases</span><span>Contact</span></div>
            </div>
            <div class="good-body">
              <div class="good-main">
                <span class="good-kicker">Website + Beheer, duidelijk en conversiegericht</span>
                <h4>Een website die direct professioneel voelt en bezoekers naar actie stuurt.</h4>
                <div class="good-copy"><span></span><span></span><span></span></div>
                <div class="good-buttons">
                  <span class="good-btn good-btn-primary">Plan kennismaking</span>
                  <span class="good-btn good-btn-secondary">Bekijk pakketten</span>
                </div>
                <div class="good-features">
                  <div class="good-feature"><strong>Duidelijk</strong><span></span><span></span></div>
                  <div class="good-feature"><strong>Snel</strong><span></span><span></span></div>
                  <div class="good-feature"><strong>Conversie</strong><span></span><span></span></div>
                </div>
              </div>
              <div class="good-side">
                <div class="good-stat">
                  <h5>Website prestaties</h5>
                  <div class="good-stat-row">
                    <div class="good-chip"><strong>98</strong><span>Performance</span></div>
                    <div class="good-chip"><strong>+32%</strong><span>Leadflow</span></div>
                  </div>
                  <div class="good-chart">
                    <svg viewBox="0 0 220 80" fill="none">
                      <path d="M5 58 C40 50 50 55 78 34 C108 12 132 38 160 24 C182 14 198 18 215 10" stroke="#38BDF8" stroke-width="3.5"/>
                      <path d="M5 58 C40 50 50 55 78 34 C108 12 132 38 160 24 C182 14 198 18 215 10 L215 80 L5 80Z" fill="rgba(56,189,248,.14)"/>
                    </svg>
                  </div>
                </div>
                <div class="good-panel">
                  <ul>
                    <li><span>Heldere structuur</span><span>✓</span></li>
                    <li><span>Sterke CTA’s</span><span>✓</span></li>
                    <li><span>Mobielvriendelijk</span><span>✓</span></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ba-divider"></div>
      <div class="ba-track"></div>
      <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Vergelijk oude en nieuwe website">
    </div>
