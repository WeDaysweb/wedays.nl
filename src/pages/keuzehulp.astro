---
import homepage from "../data/homepage.json";
import packages from "../data/packages.json";
import "../styles/global.css";
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{homepage.seo.title}</title>
    <meta name="description" content={homepage.seo.description} />
    <link rel="canonical" href="https://wedays.nl/keuzehulp" />
    <link rel="icon" type="image/png" href="/wedays-logo-full.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://wedays.nl/#organization",
          "name": "WeDays",
          "url": "https://wedays.nl/",
          "logo": "https://wedays.nl/wedays-logo-full.png",
          "image": "https://wedays.nl/wedays-logo-full.png",
          "description": "WeDays ontwerpt en bouwt op maat gemaakte websites voor bedrijven die online willen opvallen \u2014 premium design, sterke conversie en een degelijke technische basis.",
          "email": "info@wedays.nl",
          "address": { "@type": "PostalAddress", "addressCountry": "NL" }
        },
        {
          "@type": "WebSite",
          "@id": "https://wedays.nl/#website",
          "url": "https://wedays.nl/",
          "name": "WeDays",
          "publisher": { "@id": "https://wedays.nl/#organization" },
          "inLanguage": "nl-NL"
        },
        {
          "@type": "Website + DomeinService",
          "@id": "https://wedays.nl/#service",
          "name": "WeDays Webdesign",
          "url": "https://wedays.nl/",
          "image": "https://wedays.nl/wedays-logo-full.png",
          "provider": { "@id": "https://wedays.nl/#organization" },
          "areaServed": "NL",
          "priceRange": "\u20ac1.245+",
          "serviceType": ["Website laten maken", "Website redesign", "Landingspagina", "Webteksten", "Basis SEO"]
        }
      ]
    }
    </script>
  </head>
  <body>
<div class="progress"></div><div class="page-bg"></div><div class="noise"></div>
<header class="nav"><div class="container nav-inner"><a class="logo brand-logo" href="/" data-route="home" aria-label="WeDays home"><img class="brand-full-logo" src="/wedays-logo-full.png" alt="WeDays" width="192" height="58" /></a><nav class="nav-links"><a href="/diensten" data-route="diensten">Diensten</a><a href="/pakketten" data-route="pakketten">Pakketten</a><a href="/portfolio" data-route="portfolio">Cases</a><a href="/werkwijze" data-route="werkwijze">Werkwijze</a><a href="/website-scan" data-route="website-scan">Website Scan</a><a href="/blog" data-route="blog">Blog</a></nav><div class="nav-actions"><a class="btn btn-secondary" href="/keuzehulp" data-route="keuzehulp">Keuzehulp</a><a class="btn btn-primary" href="/contact" data-route="contact">Plan kennismaking →</a></div><button class="menu-btn">☰</button></div></header>
<main><div id="page-home" class="preview-page">
<section class="hero">
  <div class="container hero-grid">
    <div class="reveal">
      <span class="eyebrow">{homepage.hero.eyebrow}</span>
      <h1>{homepage.hero.titleBefore} <span class="hero-accent">{homepage.hero.accent}</span> {homepage.hero.titleAfter}</h1>
      <p class="lead"><strong>{homepage.hero.leadStrong}</strong> {homepage.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact" data-route="contact">{homepage.hero.primaryCta.label}</a>
        <a class="btn btn-secondary" href="/website-scan" data-route="website-scan">{homepage.hero.secondaryCta.label}</a>
      </div>
      <div class="trust-points">
        {homepage.hero.trustPoints.map((item) => <span>{item}</span>)}
      </div>
      <div class="hero-micro">{homepage.hero.micro}</div>
    </div>

    <div class="hero-visual reveal">
      <div class="orb one"></div>
      <div class="orb two"></div>
      <div class="dashboard">
        <div class="dash-top">
          <strong>Website Performance</strong>
          <div class="dots"><i></i><i></i><i></i></div>
        </div>
        <div class="dash-grid">
          <div class="metric"><strong>98</strong><span>Performance score</span></div>
          <div class="metric"><strong>+32%</strong><span>Aanvraagflow</span></div>
          <div class="metric"><strong>1.2s</strong><span>Laadindicatie</span></div>
          <div class="metric"><strong>SEO</strong><span>Heldere structuur</span></div>
        </div>
        <div class="chart">
          <svg viewBox="0 0 600 160" fill="none">
            <path d="M0 120 C90 90 115 115 190 70 C260 28 320 80 390 40 C470 -5 520 35 600 15" stroke="#67E8F9" stroke-width="5"/>
            <path d="M0 120 C90 90 115 115 190 70 C260 28 320 80 390 40 C470 -5 520 35 600 15 L600 160 L0 160Z" fill="rgba(56,189,248,.16)"/>
          </svg>
        </div>
      </div>
      <div class="floating-card">
        <strong>Nieuwe aanvraag</strong>
        <p>Bezoeker begrijpt je aanbod en zet de volgende stap.</p>
      </div>
    </div>
  </div>
</section>

<section class="lifeline-section">
  <div class="container reveal">
    <div class="lifeline-wrap">
      <div class="lifeline-intro">
        <div>
          <span class="eyebrow">De levenslijn van WeDays</span>
          <h2>Zes principes die in elke website blijven doorstromen.</h2>
        </div>
        <p>Dit zijn geen losse voordelen, maar de vaste punten waar elke WeDays-website op gebouwd wordt — van eerste indruk tot contactaanvraag.</p>
      </div>

      <div class="lifeline-svg" aria-hidden="true">
        <svg viewBox="0 0 1140 92" preserveAspectRatio="none">
          <path class="lifeline-path-bg lifeline-wave" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
          <path class="lifeline-path" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
          <path class="lifeline-glow-soft" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
          <path class="lifeline-glow-core" d="M 5 48 L 110 48 L 126 48 L 136 30 L 150 62 L 168 18 L 190 48 L 285 48 L 300 48 L 312 34 L 324 58 L 338 24 L 360 48 L 455 48 L 470 48 L 482 40 L 494 60 L 510 22 L 532 48 L 627 48 L 642 48 L 654 30 L 666 58 L 680 24 L 702 48 L 797 48 L 812 48 L 824 36 L 836 56 L 850 24 L 872 48 L 967 48 L 982 48 L 994 34 L 1006 60 L 1020 26 L 1042 48 L 1135 48"/>
        </svg>
      </div>

      <div class="lifeline-grid">
        <div class="lifeline-card">
          <span class="lifeline-num">01</span>
          <h3>Snel gebouwd</h3>
          <p>Tempo zonder rommelig te worden. Snel opleveren met een professionele basis die direct klopt.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">02</span>
          <h3>Mobielvriendelijk</h3>
          <p>Een sterke ervaring op telefoon, omdat daar vaak de eerste echte kennismaking plaatsvindt.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">03</span>
          <h3>Conversiegericht</h3>
          <p>Bezoekers moeten niet zoeken. De route naar contact, scan of aanvraag hoort vanzelf duidelijk te zijn.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">04</span>
          <h3>Professioneel design</h3>
          <p>Clean, premium en rustig — een uitstraling die past bij de kwaliteit van het bedrijf erachter.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">05</span>
          <h3>Basis SEO</h3>
          <p>De fundering staat goed: logische headings, metadata, structuur en snelheid als nette technische basis.</p>
        </div>
        <div class="lifeline-card">
          <span class="lifeline-num">06</span>
          <h3>Duidelijke communicatie</h3>
          <p>Heldere teksten en logische opbouw, zodat bezoekers direct begrijpen wat je doet en waarom.</p>
        </div>
      </div>
      <div class="lifeline-note">De lijn blijft bewegen — net als de aandacht, structuur en flow van een goede website.</div>
    </div>
  </div>
</section>

<section class="section"><div class="container split"><div class="reveal"><span class="eyebrow">Herkenbaar probleem</span><h2>Je website is vaak de eerste indruk. Zorg dat die klopt.</h2><p>Een verouderde of onduidelijke website kost vertrouwen. Bezoekers twijfelen, vinden niet wat ze zoeken of nemen geen contact op.</p></div><div class="grid-2 reveal"><div class="card"><h3>Verouderde uitstraling</h3><p>De website past niet meer bij de kwaliteit van het bedrijf.</p></div><div class="card"><h3>Weinig aanvragen</h3><p>Er zijn bezoekers, maar geen duidelijke route naar contact.</p></div><div class="card"><h3>Slecht mobiel</h3><p>Op telefoon voelt de site traag, rommelig of onduidelijk.</p></div><div class="card"><h3>Geen scherpe boodschap</h3><p>Het is niet meteen duidelijk wat je doet en waarom men voor jou moet kiezen.</p></div></div></div></section>
<section class="section"><div class="container"><div class="reveal"><span class="eyebrow">De oplossing</span><h2>Strak design, duidelijke structuur en slimme techniek.</h2><p class="lead">WeDays combineert premium ontwerp, conversiegerichte teksten, snelle techniek en logische CTA’s in één professionele website.</p></div><div class="grid-3"><div class="card reveal"><div class="icon">◎</div><h3>Website laten maken</h3><p>Voor bedrijven die professioneel online willen staan met een moderne website.</p><a href="/diensten" data-route="diensten">Bekijk dienst →</a></div><div class="card reveal"><div class="icon">↻</div><h3>Website redesign</h3><p>Van verouderd naar professioneel, duidelijk en conversiegericht.</p><a href="/diensten" data-route="diensten">Bekijk dienst →</a></div><div class="card reveal"><div class="icon">↗</div><h3>Landingspagina</h3><p>Gericht op campagnes, leads, acties en één duidelijke conversie.</p><a href="/diensten" data-route="diensten">Bekijk dienst →</a></div><div class="card reveal"><div class="icon">✎</div><h3>Webteksten</h3><p>Heldere teksten die uitleggen, overtuigen en vertrouwen geven.</p><a href="/diensten" data-route="diensten">Bekijk dienst →</a></div><div class="card reveal"><div class="icon">⌕</div><h3>Basis SEO</h3><p>Een nette SEO-basis met metadata, structuur en relevante zoekwoorden.</p><a href="/diensten" data-route="diensten">Bekijk dienst →</a></div><div class="card reveal"><div class="icon">⚡</div><h3>AI & automatisering</h3><p>Optioneel: slimme formulieren, leadflows en automatische opvolging.</p><a href="/diensten" data-route="diensten">Bekijk dienst →</a></div></div></div></section>

<section class="section">
  <div class="container grid-2">
    <div class="reveal">
      <span class="eyebrow">Meer dan mooi</span>
      <h2>Een goede website doet meer dan er mooi uitzien.</h2>
      <ul class="list">
        <li>Wekt vertrouwen bij nieuwe bezoekers</li>
        <li>Maakt direct duidelijk wat je doet</li>
        <li>Stuurt bezoekers naar de juiste actie</li>
        <li>Werkt snel en prettig op mobiel</li>
        <li>Past bij de kwaliteit van je bedrijf</li>
      </ul>
    </div>
    <div class="before-after reveal" data-before-after>
      <div class="ba-layer ba-before">
        <div class="ba-inner">
          <span class="ba-label ba-label-old">Oude website</span>
          <div class="ba-frame bad-site">
            <div class="bad-top"><i></i><i></i><i></i></div>
            <div class="bad-header">
              <div class="bad-logo">SUPER SNEL • GOEDKOOP • ALLES!!!</div>
              <div class="bad-nav"><span>HOME</span><span>OVER</span><span>ALLES</span><span>CONTACT</span></div>
            </div>
            <div class="bad-body">
              <div class="bad-main">
                <span class="bad-badge">NU TIJDELIJK! BEL ONS!</span>
                <h4>WIJ DOEN ECHT ALLES VOOR IEDEREEN!!!</h4>
                <div class="bad-lines"><span></span><span></span><span></span><span></span></div>
                <div class="bad-buttons">
                  <span class="bad-btn bad-btn-red">Klik hier</span>
                  <span class="bad-btn bad-btn-green">Vraag offerte</span>
                </div>
                <div class="bad-grid">
                  <div class="bad-card"><strong>Onze service</strong><span></span><span></span></div>
                  <div class="bad-card"><strong>Waarom wij?</strong><span></span><span></span></div>
                  <div class="bad-card"><strong>Nieuws</strong><span></span><span></span></div>
                  <div class="bad-card"><strong>Acties!!!</strong><span></span><span></span></div>
                </div>
              </div>
              <div class="bad-sidebar">
                <div class="bad-alert">Te veel tekst, drukke kleuren, geen focus en geen duidelijke route.</div>
                <h5>Laatste updates</h5>
                <div class="bad-side-lines"><span></span><span></span><span></span></div>
                <div class="bad-ad"></div>
                <div class="bad-mini"><span></span><span></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ba-layer ba-after">
        <div class="ba-inner">
          <span class="ba-label ba-label-new">Nieuwe website</span>
          <div class="ba-frame good-site">
            <div class="good-top"><i></i><i></i><i></i></div>
            <div class="good-header">
              <div class="good-brand"><span class="good-brand-mark"><span class="gb-w">W</span><span class="gb-d">D</span></span>WeDays</div>
              <div class="good-nav"><span>Diensten</span><span>Pakketten</span><span>Cases</span><span>Contact</span></div>
            </div>
            <div class="good-body">
              <div class="good-main">
                <span class="good-kicker">Website + Beheer, duidelijk en conversiegericht</span>
                <h4>Een website die direct professioneel voelt en bezoekers naar actie stuurt.</h4>
                <div class="good-copy"><span></span><span></span><span></span></div>
                <div class="good-buttons">
                  <span class="good-btn good-btn-primary">Plan kennismaking</span>
                  <span class="good-btn good-btn-secondary">Bekijk pakketten</span>
                </div>
                <div class="good-features">
                  <div class="good-feature"><strong>Duidelijk</strong><span></span><span></span></div>
                  <div class="good-feature"><strong>Snel</strong><span></span><span></span></div>
                  <div class="good-feature"><strong>Conversie</strong><span></span><span></span></div>
                </div>
              </div>
              <div class="good-side">
                <div class="good-stat">
                  <h5>Website prestaties</h5>
                  <div class="good-stat-row">
                    <div class="good-chip"><strong>98</strong><span>Performance</span></div>
                    <div class="good-chip"><strong>+32%</strong><span>Leadflow</span></div>
                  </div>
                  <div class="good-chart">
                    <svg viewBox="0 0 220 80" fill="none">
                      <path d="M5 58 C40 50 50 55 78 34 C108 12 132 38 160 24 C182 14 198 18 215 10" stroke="#38BDF8" stroke-width="3.5"/>
                      <path d="M5 58 C40 50 50 55 78 34 C108 12 132 38 160 24 C182 14 198 18 215 10 L215 80 L5 80Z" fill="rgba(56,189,248,.14)"/>
                    </svg>
                  </div>
                </div>
                <div class="good-panel">
                  <ul>
                    <li><span>Heldere structuur</span><span>✓</span></li>
                    <li><span>Sterke CTA’s</span><span>✓</span></li>
                    <li><span>Mobielvriendelijk</span><span>✓</span></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ba-divider"></div>
      <div class="ba-track"></div>
      <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Vergelijk oude en nieuwe website">
    </div>
  </div>
</section>


<section class="section packages-section">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">Pakketten</span>
      <h2>Eén op maat gebouwde website. Drie niveaus van gemak.</h2>
      <p class="lead">Elke website wordt 100% op maat ontworpen en gebouwd — geen sjablonen, geen compromissen. Jij kiest hoeveel wij na de lancering voor je blijven regelen.</p>
    </div>

    <div class="packages-grid packages-grid-v2">
      {packages.map((pkg) => (
        <div class={`card package package-v2 ${pkg.className} ${pkg.featured ? "featured" : ""} reveal`}>
          {pkg.featured && <span class="pv2-ribbon">Meest gekozen</span>}
          <div class="package-v2-top">
            <span class="badge">{pkg.badge}</span>
            <h3>{pkg.name}</h3>
            <p>{pkg.summary}</p>
          </div>
          <div class="package-v2-price">
            <span class="pv2-amount">{pkg.priceMain}</span>
            <span class="pv2-period">{pkg.priceSub}</span>
          </div>
          <ul class="package-list">
            {pkg.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <a class={`btn ${pkg.primary ? "btn-primary" : "btn-secondary"} package-v2-cta`} href={pkg.cta.href} data-route="contact">
            <span>{pkg.cta.label}</span>
          </a>
          <p class="package-v2-micro">{pkg.micro}</p>
        </div>
      ))}
    </div>

    <p class="package-note reveal">Alle pakketten bevatten exact dezelfde op maat gebouwde website. Het verschil zit in het gemak daarna — van volledige zelfstandigheid tot een volledig zorgeloze, doorlopend onderhouden website.</p>
  </div>
</section>

<section class="section"><div class="container"><div class="cta-band reveal"><div><h2>Benieuwd waar je huidige website beter kan?</h2><p>Laat WeDays kijken naar uitstraling, structuur, mobiel gebruik, snelheid en conversie.</p></div><a class="btn btn-primary" href="/website-scan" data-route="website-scan">Laat mijn website beoordelen →</a></div></div></section>
<section class="section"><div class="container"><div class="reveal"><span class="eyebrow">Werkwijze</span><h2>Van eerste gesprek naar professionele lancering.</h2></div><div class="grid-3"><div class="step reveal"><div><h3>Kennismaking</h3><p>We bespreken je bedrijf, doelen en wensen.</p></div></div><div class="step reveal"><div><h3>Strategie & design</h3><p>We bepalen structuur, stijl en conversieroute.</p></div></div><div class="step reveal"><div><h3>Bouw & lancering</h3><p>We bouwen, verwerken feedback en zetten de site live.</p></div></div></div></div></section>
</div>
<section id="page-over-ons" class="preview-page">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Over WeDays</span>
      <h2>Websites die online dezelfde kwaliteit uitstralen als jouw bedrijf in de praktijk.</h2>
      <p class="lead">Veel bedrijven leveren goed werk, maar hun website vertelt dat verhaal niet sterk genoeg. WeDays maakt van die eerste indruk een professionele, duidelijke en betrouwbare ervaring.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-3">
      <div class="card"><h3>Missie</h3><p>Bedrijven en organisaties helpen om online professioneler, duidelijker en overtuigender over te komen.</p></div>
      <div class="card"><h3>Visie</h3><p>Een goede website moet niet voelen als een online folder, maar als een slimme commerciële basis.</p></div>
      <div class="card"><h3>Werkwijze</h3><p>Rustig design, heldere structuur, sterke teksten en techniek die snel en betrouwbaar werkt.</p></div>
    </div>
  </section>
</section>


<section id="page-diensten" class="preview-page">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Diensten</span>
      <h2>Niet zomaar een website. Een online ervaring die klopt.</h2>
      <p class="lead">Kies waar je website de meeste winst kan pakken: uitstraling, structuur, tekst, vindbaarheid of conversie.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-shell">
        <div class="services-intro">
          <div>
            <span class="eyebrow">Wat WeDays bouwt</span>
            <h2>Elke dienst maakt je website sterker op een beslissend punt.</h2>
          </div>
          <p>Een professionele website ontstaat niet door alleen een mooi ontwerp. Het gaat om de combinatie van eerste indruk, duidelijke boodschap, snelle techniek en een route die bezoekers vanzelf begrijpen.</p>
        </div>

        <div class="services-menu">
          <article class="service-choice featured-service">
            <div class="service-icon">◆</div>
            <h3>Website laten maken</h3>
            <div class="service-promise">Een complete website die direct professioneel voelt.</div>
            <p>Voor bedrijven en organisaties die online sterker, rustiger en betrouwbaarder willen overkomen.</p>
            <ul class="service-benefits"><li>Website + Beheer eerste indruk</li><li>Logische paginastructuur</li><li>Sterke CTA’s richting contact</li></ul>
            <a class="btn btn-primary" href="/contact" data-route="contact">Start project →</a>
          </article>

          <article class="service-choice">
            <div class="service-icon">↻</div>
            <h3>Website redesign</h3>
            <div class="service-promise">Van rommelig en verouderd naar strak en overtuigend.</div>
            <p>We vernieuwen uitstraling, opbouw en conversieroute zonder dat je merk zijn herkenbaarheid verliest.</p>
            <ul class="service-benefits"><li>Meer rust en overzicht</li><li>Betere mobiele ervaring</li><li>Duidelijkere aanvraagroute</li></ul>
            <a class="btn btn-secondary" href="/website-scan" data-route="website-scan">Doe Website Scan</a>
          </article>

          <article class="service-choice">
            <div class="service-icon">↗</div>
            <h3>Landingspagina</h3>
            <div class="service-promise">Eén pagina met één doel: bezoekers laten klikken.</div>
            <p>Ideaal voor campagnes, advertenties, acties, diensten of leadgeneratie met minder afleiding.</p>
            <ul class="service-benefits"><li>Scherpe boodschap</li><li>Focus op conversie</li><li>Perfect voor campagnes</li></ul>
            <a class="btn btn-secondary" href="/contact" data-route="contact">Bespreek pagina</a>
